-- .luacov — configuration de la couverture pour CustosVirginum
--
-- Utilisation :
--   make coverage             → compile + busted --coverage + luacov
--   tmp/coverage/luacov.report.out  → rapport texte
--
-- ATTENTION : sur la suite complète (tests/unit), luacov instrumente CHAQUE
-- ligne exécutée (debug.sethook "l") et désactive le JIT LuaJIT — ~4x plus
-- lent que l'alternative ci-dessous, et a déjà échoué à écrire son fichier de
-- stats en fin de run (cf. AGENTS.md § Corrections d'audit 2026-07-16).
-- Préférer `make coverage-quick` (tests/helpers/quick_coverage_setup.lua) pour
-- un ordre de grandeur rapide ; ne lancer `make coverage` que pour un chiffre
-- exact ciblé sur un sous-ensemble (`tests/unit/<module>`).

return {
  statsfile  = "tmp/coverage/luacov.stats.out",
  reportfile = "tmp/coverage/luacov.report.out",

  -- Seul le code produit (lua/) nous intéresse.
  include = {
    "^lua/",
  },

  -- Exclure les modules système, FFI bas-niveau et les exemples.
  exclude = {
    "^tests/",
    "^tmp/",
    "^%.kilo/",
    "^libvirt/",
    "^lua/ipparse/",   -- bibliothèque séparée, coverage géré indépendamment
    -- Les stubs FFI pur ne peuvent pas être couverts sans les bibliothèques
    -- natives ; on les exclut au départ pour éviter du bruit.
    "^lua/ffi_defs",
    "^lua/ffi_ndpi",
    "^lua/ffi_xxhash",
    "^lua/auth/ffi_socket",
    "^lua/auth/ffi_wolfssl",
  },
}
