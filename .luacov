-- .luacov — configuration de la couverture pour CustosVirginum
--
-- Utilisation :
--   make coverage-split      → couverture exacte fiable (un processus Busted
--                              par fichier de spec, stats fusionnées ; ~30 min)
--   make coverage            → variante mono-processus (plus rapide sur un
--                              sous-ensemble, mais peut mourir par SIGSEGV
--                              LuaJIT sous le hook luacov : préférer
--                              coverage-split pour la suite complète)
--   tmp/coverage/luacov.report.out  → rapport texte (tableau Summary en fin)
--
-- luacov instrumente CHAQUE ligne exécutée (debug.sethook "l") et désactive le
-- JIT LuaJIT : le chiffre est exact, contrairement à `make coverage-quick`
-- (échantillonnage, sous-estime). Pour un module isolé, lancer la même cible
-- sur `tests/unit/<module>` et lire sa section du rapport.

return {
  statsfile  = "tmp/coverage/luacov.stats.out",
  reportfile = "tmp/coverage/luacov.report.out",

  -- Compter aussi les fichiers de lua/ jamais chargés (0 %), pour un
  -- pourcentage réellement global. Une table (et non `true`) limite le
  -- balayage à lua/ : le scanner de luacov casse sur les liens morts de `.`.
  includeuntestedfiles = { "lua" },

  -- Seul le code produit (lua/) nous intéresse.
  include = {
    "^lua/",
  },

  -- Exclure les modules système, FFI bas-niveau et les exemples.
  exclude = {
    "^tests/",
    "^tmp/",
    "^%.kilo/",
    "^libvirt/",
    "^lua/ipparse/",      -- bibliothèque séparée, coverage géré indépendamment
    -- Runtime MoonScript embarqué (sous-module tiers, compilé à part) : ce
    -- n'est pas du code du projet (même liste que tests/helpers/coverage_filters).
    "^lua/moonscript/",
    "^lua/moon/",
    -- Les stubs FFI pur ne peuvent pas être couverts sans les bibliothèques
    -- natives ; on les exclut au départ pour éviter du bruit.
    "^lua/ffi_defs",
    "^lua/ffi_ndpi",
    "^lua/ffi_xxhash",
    "^lua/auth/ffi_socket",
    "^lua/auth/ffi_wolfssl",
  },
}
